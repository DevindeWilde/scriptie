#!/bin/bash
#SBATCH --job-name=saab-lw4
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/saab-lw4-%j.out
#SBATCH --error=logs/saab-lw4-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs
CFG=$HOME/scriptie/ednet/cfg/models/ednet/ednet-s.yaml
YAML=$HOME/scriptie/yaml

# SA-AB loss weight ablation: cls=4.0, box=4.0

# ── Stage 2 ─────────────────────────────────────────────────────────────────
# Starting from existing stage-1 weights + buffers.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage2-replay.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_lw4 \
  --name stage2-saab \
  --workers 8 \
  --weights $RUNS/dota_saab/stage1-saab/weights/best.pt \
  --override "stage.active_classes=[2,3]" \
  --override "stage.prev_classes=[0,1]" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=4.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab/stage1-saab/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=4.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab/stage1-saab/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

# ── Stage 3 ─────────────────────────────────────────────────────────────────
# Introduce {4: ship}. Load stage-2 buffers from this run.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage3-replay.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_lw4 \
  --name stage3-saab \
  --workers 8 \
  --weights $RUNS/dota_saab_lw4/stage2-saab/weights/best.pt \
  --override "stage.active_classes=[4]" \
  --override "stage.prev_classes=[0,1,2,3]" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=4.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab_lw4/stage2-saab/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=4.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab_lw4/stage2-saab/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

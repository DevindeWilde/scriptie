#!/bin/bash
#SBATCH --job-name=saab-lw-val
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/saab-lw-val-%j.out
#SBATCH --error=logs/saab-lw-val-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs
YAML=$HOME/scriptie/yaml
VALDIR=$RUNS/val

run_val() {
    local weights=$1
    local data=$2
    local outdir=$3
    echo "────────────────────────────────────────────────────────────────"
    echo "  weights : $weights"
    echo "  data    : $data"
    echo "  outdir  : $outdir"
    echo "────────────────────────────────────────────────────────────────"
    python val.py \
        --weights "$weights" \
        --data "$data" \
        --imgsz 640 \
        --split test \
        --outdir "$outdir"
}

# ── SA-AB λ=4.0 ──────────────────────────────────────────────────────────────
run_val $RUNS/dota_saab_lw4/stage2-saab/weights/best.pt \
        $YAML/DOTA-shared-stage2.yaml \
        $VALDIR/saab-lw4/stage2

run_val $RUNS/dota_saab_lw4/stage3-saab/weights/best.pt \
        $YAML/DOTA-shared-stage3.yaml \
        $VALDIR/saab-lw4/stage3

# ── SA-AB λ=8.0 ──────────────────────────────────────────────────────────────
run_val $RUNS/dota_saab_lw8/stage2-saab/weights/best.pt \
        $YAML/DOTA-shared-stage2.yaml \
        $VALDIR/saab-lw8/stage2

run_val $RUNS/dota_saab_lw8/stage3-saab/weights/best.pt \
        $YAML/DOTA-shared-stage3.yaml \
        $VALDIR/saab-lw8/stage3

# ── SA-AB λ=12.0 ─────────────────────────────────────────────────────────────
run_val $RUNS/dota_saab_lw12/stage2-saab/weights/best.pt \
        $YAML/DOTA-shared-stage2.yaml \
        $VALDIR/saab-lw12/stage2

run_val $RUNS/dota_saab_lw12/stage3-saab/weights/best.pt \
        $YAML/DOTA-shared-stage3.yaml \
        $VALDIR/saab-lw12/stage3

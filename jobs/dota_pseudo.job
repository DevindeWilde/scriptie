#!/bin/bash
#SBATCH --job-name=dota-pseudo
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/dota-pseudo-%j.out
#SBATCH --error=logs/dota-pseudo-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs
CFG=$HOME/scriptie/ednet/cfg/models/ednet/ednet-s.yaml
PRETRAINED=$HOME/scriptie/pretrained/small.pt
PL=$RUNS/dota_pseudo/pseudo_labels  # pseudo-label output root

# ── Stage 1 ─────────────────────────────────────────────────────────────────
# Train on classes {0: small-vehicle, 1: large-vehicle} — no pseudo-labels yet
python train.py \
  --cfg $CFG \
  --data $HOME/scriptie/yaml/DOTA-stage1.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_pseudo \
  --name stage1-pseudo \
  --workers 8 \
  --weights $PRETRAINED \
  --override "stage.active_classes=[0,1]"

# ── Generate pseudo-labels for Stage 2 ──────────────────────────────────────
# Run stage-1 model on stage-2 train images; keep confident predictions for
# old classes {0,1}; conflict-remove against stage-2 GT boxes
python scripts/generate_pseudo_labels.py \
  --weights $RUNS/dota_pseudo/stage1-pseudo/weights/best.pt \
  --data $HOME/scriptie/yaml/DOTA-stage2.yaml \
  --prev-classes 0 1 \
  --outdir $PL/stage2 \
  --conf 0.5 \
  --conflict-iou 0.5

# ── Stage 2 ─────────────────────────────────────────────────────────────────
# Introduce {2: plane, 3: helicopter}; old classes supervised via pseudo-labels.
# active_classes=[2,3] is automatically extended to [0,1,2,3] by the trainer
# when pseudo_labels_dir is set together with prev_classes.
python train.py \
  --cfg $CFG \
  --data $HOME/scriptie/yaml/DOTA-stage2.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_pseudo \
  --name stage2-pseudo \
  --workers 8 \
  --weights $RUNS/dota_pseudo/stage1-pseudo/weights/best.pt \
  --override "stage.active_classes=[2,3]" \
  --override "stage.prev_classes=[0,1]" \
  --override "stage.pseudo_labels_dir=$PL/stage2"

# ── Generate pseudo-labels for Stage 3 ──────────────────────────────────────
# Run stage-2 model (nc=4) on stage-3 train images; keep predictions for
# old classes {0,1,2,3}
python scripts/generate_pseudo_labels.py \
  --weights $RUNS/dota_pseudo/stage2-pseudo/weights/best.pt \
  --data $HOME/scriptie/yaml/DOTA-stage3.yaml \
  --prev-classes 0 1 2 3 \
  --outdir $PL/stage3 \
  --conf 0.5 \
  --conflict-iou 0.5

# ── Stage 3 ─────────────────────────────────────────────────────────────────
# Introduce {4: ship}; old classes supervised via pseudo-labels.
# active_classes=[4] is automatically extended to [0,1,2,3,4] by the trainer.
python train.py \
  --cfg $CFG \
  --data $HOME/scriptie/yaml/DOTA-stage3.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_pseudo \
  --name stage3-pseudo \
  --workers 8 \
  --weights $RUNS/dota_pseudo/stage2-pseudo/weights/best.pt \
  --override "stage.active_classes=[4]" \
  --override "stage.prev_classes=[0,1,2,3]" \
  --override "stage.pseudo_labels_dir=$PL/stage3"

#!/bin/bash
#SBATCH --job-name=dota-eval-size
#SBATCH --time=4:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/dota-eval-size-%j.out
#SBATCH --error=logs/dota-eval-size-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs
YAML=$HOME/scriptie/yaml
OUTDIR=$RUNS/val_by_size

run_eval() {
    local weights=$1
    local data=$2
    local out=$3
    echo "────────────────────────────────────────────────────────────────"
    echo "  weights : $weights"
    echo "  data    : $data"
    echo "  out     : $out"
    echo "────────────────────────────────────────────────────────────────"
    python scripts/eval_by_size.py \
        --weights "$weights" \
        --data "$data" \
        --split test \
        --imgsz 640 \
        --out "$out"
}

# ── Lower bound (naive finetuning) ───────────────────────────────────────────
run_eval $RUNS/dota_lower/stage1-lower/weights/best.pt \
         $YAML/DOTA-shared-stage1.yaml \
         $OUTDIR/lower/stage1.json

run_eval $RUNS/dota_lower/stage2-lower/weights/best.pt \
         $YAML/DOTA-shared-stage2.yaml \
         $OUTDIR/lower/stage2.json

run_eval $RUNS/dota_lower/stage3-lower/weights/best.pt \
         $YAML/DOTA-shared-stage3.yaml \
         $OUTDIR/lower/stage3.json

# ── Annotation replay (shared-pool label merging) ─────────────────────────────
run_eval $RUNS/dota_replay/stage1-replay/weights/best.pt \
         $YAML/DOTA-shared-stage1.yaml \
         $OUTDIR/replay/stage1.json

run_eval $RUNS/dota_replay/stage2-replay/weights/best.pt \
         $YAML/DOTA-shared-stage2.yaml \
         $OUTDIR/replay/stage2.json

run_eval $RUNS/dota_replay/stage3-replay/weights/best.pt \
         $YAML/DOTA-shared-stage3.yaml \
         $OUTDIR/replay/stage3.json

# ── Knowledge distillation ────────────────────────────────────────────────────
run_eval $RUNS/dota_kd/stage1-kd/weights/best.pt \
         $YAML/DOTA-shared-stage1.yaml \
         $OUTDIR/kd/stage1.json

run_eval $RUNS/dota_kd/stage2-kd/weights/best.pt \
         $YAML/DOTA-shared-stage2.yaml \
         $OUTDIR/kd/stage2.json

run_eval $RUNS/dota_kd/stage3-kd/weights/best.pt \
         $YAML/DOTA-shared-stage3.yaml \
         $OUTDIR/kd/stage3.json

# ── Pseudo-labeling ───────────────────────────────────────────────────────────
run_eval $RUNS/dota_pseudo/stage1-pseudo/weights/best.pt \
         $YAML/DOTA-shared-stage1.yaml \
         $OUTDIR/pseudo/stage1.json

run_eval $RUNS/dota_pseudo/stage2-pseudo/weights/best.pt \
         $YAML/DOTA-shared-stage2.yaml \
         $OUTDIR/pseudo/stage2.json

run_eval $RUNS/dota_pseudo/stage3-pseudo/weights/best.pt \
         $YAML/DOTA-shared-stage3.yaml \
         $OUTDIR/pseudo/stage3.json

# ── SA-AB (cls + box prototype consistency + memory replay) ───────────────────
run_eval $RUNS/dota_saab/stage1-saab/weights/best.pt \
         $YAML/DOTA-shared-stage1.yaml \
         $OUTDIR/saab/stage1.json

run_eval $RUNS/dota_saab/stage2-saab/weights/best.pt \
         $YAML/DOTA-shared-stage2.yaml \
         $OUTDIR/saab/stage2.json

run_eval $RUNS/dota_saab/stage3-saab/weights/best.pt \
         $YAML/DOTA-shared-stage3.yaml \
         $OUTDIR/saab/stage3.json

# ── Upper bound (joint training, oracle) ─────────────────────────────────────
run_eval $RUNS/dota_upper/upper/weights/best.pt \
         $YAML/DOTA-filtered.yaml \
         $OUTDIR/upper/final.json

#!/bin/bash
#SBATCH --job-name=dota-saab
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/dota-saab-%j.out
#SBATCH --error=logs/dota-saab-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs_15
CFG=$HOME/scriptie/ednet/cfg/models/ednet/ednet-s.yaml
PRETRAINED=$HOME/scriptie/pretrained/small.pt
YAML=$HOME/scriptie/yaml

# SA-AB: classification + bounding-box prototype consistency (full implementation).
# Shared image pool for training; old-class GT baked into train_replay/ labels (25 images/class).
# Cls prototypes stored in  replay/buffer.pt
# Box prototypes stored in  replay/box_buffer.pt

# ── Stage 1 ─────────────────────────────────────────────────────────────────
# Train on {0: small-vehicle, 1: large-vehicle}.
# No prior teacher buffer — consistency loss is silent this stage.
# Both cls and box student buffers accumulate and are saved for stage 2.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage1.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab \
  --name stage1-saab \
  --workers 8 \
  --weights $PRETRAINED \
  --override "stage.active_classes=[0,1]" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=10.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=3.0" \
  --override "replay.student_update_freq=10" 

# ── Stage 2 ─────────────────────────────────────────────────────────────────
# Introduce {2: plane, 3: helicopter}.
# Load stage-1 cls + box prototype buffers as teacher.
# Old-class GT is baked into train_replay/ labels (25 images/class) — no external memory needed.
# active_classes is auto-extended to [0,1,2,3] by the trainer (prev_classes set).
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage2-replay.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab \
  --name stage2-saab \
  --workers 8 \
  --weights $RUNS/dota_saab/stage1-saab/weights/best.pt \
  --override "stage.active_classes=[2,3]" \
  --override "stage.prev_classes=[0,1]" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=10.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab/stage1-saab/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=3.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab/stage1-saab/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10" \

# ── Stage 3 ─────────────────────────────────────────────────────────────────
# Introduce {4: ship}.
# Load stage-2 cls + box prototype buffers as teacher.
# Old-class GT is baked into train_replay/ labels (25 images/class) — no external memory needed.
# active_classes is auto-extended to [0,1,2,3,4] by the trainer (prev_classes set).
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage3-replay.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab \
  --name stage3-saab \
  --workers 8 \
  --weights $RUNS/dota_saab/stage2-saab/weights/best.pt \
  --override "stage.active_classes=[4]" \
  --override "stage.prev_classes=[0,1,2,3]" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=10.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab/stage2-saab/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=3.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab/stage2-saab/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

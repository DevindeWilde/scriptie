#!/bin/bash
#SBATCH --job-name=saab-ps-lw8
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/saab-ps-lw8-%j.out
#SBATCH --error=logs/saab-ps-lw8-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs
CFG=$HOME/scriptie/ednet/cfg/models/ednet/ednet-s.yaml
YAML=$HOME/scriptie/yaml
PL=$RUNS/dota_saab_pseudo_lw8/pseudo_labels

# SA-AB + Pseudo with λ=8.0 for both cls and box prototype consistency.
# Reuses existing stage-1 weights + buffers from dota_saab.

# ── Generate pseudo-labels for Stage 2 ───────────────────────────────────
python scripts/generate_pseudo_labels.py \
  --weights $RUNS/dota_saab/stage1-saab/weights/best.pt \
  --data $YAML/DOTA-shared-stage2.yaml \
  --prev-classes 0 1 \
  --outdir $PL/stage2 \
  --conf 0.5 \
  --conflict-iou 0.5

# ── Stage 2 ─────────────────────────────────────────────────────────────────
# Introduce {2: plane, 3: helicopter}. Pseudo-labels supply old-class GT.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage2.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_pseudo_lw8 \
  --name stage2-saab-pseudo \
  --workers 8 \
  --weights $RUNS/dota_saab/stage1-saab/weights/best.pt \
  --override "stage.active_classes=[2,3]" \
  --override "stage.prev_classes=[0,1]" \
  --override "stage.pseudo_labels_dir=$PL/stage2" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=8.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab/stage1-saab/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=8.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab/stage1-saab/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

# ── Generate pseudo-labels for Stage 3 ───────────────────────────────────
python scripts/generate_pseudo_labels.py \
  --weights $RUNS/dota_saab_pseudo_lw8/stage2-saab-pseudo/weights/best.pt \
  --data $YAML/DOTA-shared-stage3.yaml \
  --prev-classes 0 1 2 3 \
  --outdir $PL/stage3 \
  --conf 0.5 \
  --conflict-iou 0.5

# ── Stage 3 ─────────────────────────────────────────────────────────────────
# Introduce {4: ship}. Pseudo-labels supply old-class GT.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage3.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_pseudo_lw8 \
  --name stage3-saab-pseudo \
  --workers 8 \
  --weights $RUNS/dota_saab_pseudo_lw8/stage2-saab-pseudo/weights/best.pt \
  --override "stage.active_classes=[4]" \
  --override "stage.prev_classes=[0,1,2,3]" \
  --override "stage.pseudo_labels_dir=$PL/stage3" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=8.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab_pseudo_lw8/stage2-saab-pseudo/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=8.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab_pseudo_lw8/stage2-saab-pseudo/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

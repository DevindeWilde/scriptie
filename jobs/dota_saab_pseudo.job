#!/bin/bash
#SBATCH --job-name=dota-saab-pseudo
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/dota-saab-pseudo-%j.out
#SBATCH --error=logs/dota-saab-pseudo-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs
CFG=$HOME/scriptie/ednet/cfg/models/ednet/ednet-s.yaml
PRETRAINED=$HOME/scriptie/pretrained/small.pt
YAML=$HOME/scriptie/yaml
PL=$RUNS/dota_saab_pseudo/pseudo_labels

# SA-AB + Pseudo: cls+box prototype consistency with pseudo-label GT for old classes.
# Stage 1 accumulates student cls+box prototype buffers (no prior teacher, no pseudo).
# Stages 2/3 load stage t-1 buffers as teacher + pseudo-labels supply old-class GT
# (replaces baked-in replay annotations; no -replay.yaml needed).

# ── Stage 1 ──────────────────────────────────────────────────────────────────
# Train on {0: small-vehicle, 1: large-vehicle}.
# Consistency loss is silent (no teacher buffer). Student cls+box buffers accumulate.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage1.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_pseudo \
  --name stage1-saab-pseudo \
  --workers 8 \
  --weights $PRETRAINED \
  --override "stage.active_classes=[0,1]" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=1.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=1.0" \
  --override "replay.student_update_freq=10"

# ── Generate pseudo-labels for Stage 2 ───────────────────────────────────────
# Run stage-1 model on stage-2 training images; keep confident predictions for
# old classes {0,1}; conflict-remove against stage-2 GT boxes.
python scripts/generate_pseudo_labels.py \
  --weights $RUNS/dota_saab_pseudo/stage1-saab-pseudo/weights/best.pt \
  --data $YAML/DOTA-shared-stage2.yaml \
  --prev-classes 0 1 \
  --outdir $PL/stage2 \
  --conf 0.5 \
  --conflict-iou 0.5

# ── Stage 2 ──────────────────────────────────────────────────────────────────
# Introduce {2: plane, 3: helicopter}.
# Load stage-1 cls+box buffers as teacher for consistency loss.
# Pseudo-labels supply old-class GT; active_classes auto-extended to [0,1,2,3].
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage2.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_pseudo \
  --name stage2-saab-pseudo \
  --workers 8 \
  --weights $RUNS/dota_saab_pseudo/stage1-saab-pseudo/weights/best.pt \
  --override "stage.active_classes=[2,3]" \
  --override "stage.prev_classes=[0,1]" \
  --override "stage.pseudo_labels_dir=$PL/stage2" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=1.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab_pseudo/stage1-saab-pseudo/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=1.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab_pseudo/stage1-saab-pseudo/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

# ── Generate pseudo-labels for Stage 3 ───────────────────────────────────────
# Run stage-2 model (nc=4) on stage-3 training images; keep predictions for
# old classes {0,1,2,3}.
python scripts/generate_pseudo_labels.py \
  --weights $RUNS/dota_saab_pseudo/stage2-saab-pseudo/weights/best.pt \
  --data $YAML/DOTA-shared-stage3.yaml \
  --prev-classes 0 1 2 3 \
  --outdir $PL/stage3 \
  --conf 0.5 \
  --conflict-iou 0.5

# ── Stage 3 ──────────────────────────────────────────────────────────────────
# Introduce {4: ship}.
# Load stage-2 cls+box buffers as teacher for consistency loss.
# Pseudo-labels supply old-class GT; active_classes auto-extended to [0,1,2,3,4].
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage3.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_saab_pseudo \
  --name stage3-saab-pseudo \
  --workers 8 \
  --weights $RUNS/dota_saab_pseudo/stage2-saab-pseudo/weights/best.pt \
  --override "stage.active_classes=[4]" \
  --override "stage.prev_classes=[0,1,2,3]" \
  --override "stage.pseudo_labels_dir=$PL/stage3" \
  --override "replay.enable=True" \
  --override "replay.buffer_per_class=128" \
  --override "replay.sample_per_batch=32" \
  --override "replay.loss_weight=1.0" \
  --override "replay.tiny_max_pixels=320" \
  --override "replay.prototypes.num_fine=4" \
  --override "replay.init_buffer=$RUNS/dota_saab_pseudo/stage2-saab-pseudo/replay/buffer.pt" \
  --override "replay.box.enable=True" \
  --override "replay.box.loss_weight=1.0" \
  --override "replay.box.init_buffer=$RUNS/dota_saab_pseudo/stage2-saab-pseudo/replay/box_buffer.pt" \
  --override "replay.student_update_freq=10"

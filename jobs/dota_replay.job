#!/bin/bash
#SBATCH --job-name=dota-replay
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --output=logs/dota-replay-%j.out
#SBATCH --error=logs/dota-replay-%j.err

module purge
module load 2023
module load CUDA/12.4.0
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ednet_env/bin/activate
cd $HOME/scriptie

RUNS=$HOME/scriptie/runs_15
CFG=$HOME/scriptie/ednet/cfg/models/ednet/ednet-s.yaml
PRETRAINED=$HOME/scriptie/pretrained/small.pt
YAML=$HOME/scriptie/yaml

# Annotation replay: shared image pool, old-class labels merged back for 25 replay
# images per old class (built by build_shared_stages.py into train_replay/labels/).
# No active_classes filtering — YOLO loss sees all annotated classes in each batch.

# ── Stage 1 ─────────────────────────────────────────────────────────────────
# Train on {0: small-vehicle, 1: large-vehicle} — no prior classes to replay
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage1.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_replay \
  --name stage1-replay \
  --workers 8 \
  --weights $PRETRAINED

# ── Stage 2 ─────────────────────────────────────────────────────────────────
# Introduce {2: plane, 3: helicopter}.
# train_replay/labels merges old-class [0,1] annotations into 50 replay images.
# No active_classes override: YOLO loss covers all annotated classes.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage2-replay.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_replay \
  --name stage2-replay \
  --workers 8 \
  --weights $RUNS/dota_replay/stage1-replay/weights/best.pt

# ── Stage 3 ─────────────────────────────────────────────────────────────────
# Introduce {4: ship}.
# train_replay/labels merges old-class [0,1,2,3] annotations into 100 replay images.
python train.py \
  --cfg $CFG \
  --data $YAML/DOTA-shared-stage3-replay.yaml \
  --epochs 50 \
  --imgsz 640 \
  --batch-size 4 \
  --project $RUNS/dota_replay \
  --name stage3-replay \
  --workers 8 \
  --weights $RUNS/dota_replay/stage2-replay/weights/best.pt
